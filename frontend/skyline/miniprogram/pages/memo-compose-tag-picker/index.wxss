page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-page);
}

.picker-shell.ds-page-inline-shell {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-top: 0;
  overflow: visible;
}

/* 标签列表 scroll-view 纵向吃满 picker-shell；顶部不留 spacer，让内容可滚到透明导航下方。 */
.tag-list-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.tag-list-scroll__content {
  min-height: 100%;
  box-sizing: border-box;
  padding-bottom: 176rpx;
}

.tag-list {
  display: flex;
  flex-direction: column;
}

.tag-list__option {
  padding: var(--spacing-sm) 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--color-border-light);
}

.tag-list__option:last-child {
  border-bottom: 0;
}

.tag-list__option--disabled .tag-list__option-text {
  color: var(--color-text-secondary);
}

.tag-list__option-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-list__option-meta {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--spacing-xs);
  margin-left: var(--spacing-sm);
}

.tag-list__option-check {
  flex: none;
  font-size: var(--input-inner-icon-size);
  color: var(--color-text-placeholder);
  line-height: 1;
}

.tag-list__option-badge {
  flex: none;
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.tag-list-status {
  padding: var(--spacing-lg) 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.tag-list-status__text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.tag-list-status__retry {
  margin-left: var(--spacing-sm);
}

/* 让导航浮层脱离 ds-page-inline-shell 的左右 margin，保持标题按全屏中线居中。 */
.tag-picker-nav-overlay {
  position: absolute;
  top: 0;
  left: calc(0rpx - var(--page-inline-shell-margin));
  right: calc(0rpx - var(--page-inline-shell-margin));
  z-index: 5;
  pointer-events: none;
}

.tag-picker-nav-mask {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  pointer-events: none;
  background-image: linear-gradient(
    0deg,
    var(--color-nav-status-mask-start) 0%,
    var(--color-nav-status-mask-mid) 45%,
    var(--color-nav-status-mask-end) 100%
  );
}

.tag-picker-nav-overlay .weui-navigation-bar {
  position: relative;
  z-index: 1;
  overflow: visible;
}

.tag-picker-nav-back-slot {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* 底部输入工具栏：保持绝对定位与键盘避让，不改现有交互语义。 */
.picker-toolbar {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: var(--icon-button-size-lg);
  padding: 0 var(--memo-layout-gutter) var(--spacing-md);
  box-sizing: border-box;
  transition: bottom 0.25s ease;
}

.picker-toolbar--rest {
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
}

.picker-toolbar__input-shell {
  flex: 1;
  min-width: 0;
  height: var(--floating-toolbar-input-shell-height);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.picker-toolbar__input-icon {
  flex: none;
  font-size: var(--input-inner-icon-size);
  margin-right: 14rpx;
  color: var(--color-text-placeholder);
  line-height: 1;
}

.picker-toolbar__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  background: transparent;
  border: 0;
  padding: 0;
  box-sizing: border-box;
}

.picker-toolbar__input-placeholder {
  color: var(--color-text-placeholder);
}
