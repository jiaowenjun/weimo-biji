@import '../../styles/memo-markdown.wxss';
@import '../../styles/memo-list.wxss';

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-page);
}

/* 与 index 列表等宽；顶不叠 ds-page-inline-shell 默认（page-shell 已有顶距）。底由 wxml 内联 keyboard 控制 */
.search-shell.ds-page-inline-shell {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-left: 0;
  margin-right: 0;
  padding-top: 0;
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
}

.page-scroll-shell {
  position: relative;
  flex: 1;
  min-height: 0;
}

.search-results-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.page-nav-spacer {
  flex: none;
}

.memo-list-filter--scroll-root {
  margin-left: var(--page-shell-inline-padding);
  margin-right: var(--page-shell-inline-padding);
}

.memo-list--scroll-content {
  margin: 0;
  padding: 0 var(--memo-layout-gutter);
}

.memo-list-builder--scroll-root {
  margin: 0;
  padding: 0;
}

.memo-list__item--scroll-root {
  padding: 0 var(--memo-layout-gutter);
  box-sizing: border-box;
}

.search-results__content {
  min-height: 100%;
  box-sizing: border-box;
  padding-bottom: 164rpx;
}

.page-shell__safe-bottom {
  flex: none;
  height: calc(env(safe-area-inset-bottom) + var(--page-shell-safe-bottom-space));
}

.footer-panel {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  width: 100%;
  padding: 0 var(--memo-layout-gutter) var(--spacing-md);
  box-sizing: border-box;
  transition: bottom 0.25s ease;
}

.footer-panel--rest {
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
}

.search-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: var(--icon-button-size-lg);
}

.search-toolbar__input-shell {
  flex: 1;
  min-width: 0;
  height: var(--floating-toolbar-input-shell-height);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.search-toolbar__input-icon {
  flex: none;
  font-size: var(--input-inner-icon-size);
  margin-right: 14rpx;
  color: var(--color-text-placeholder);
  line-height: 1;
}

.search-toolbar__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  background: transparent;
  border: 0;
  padding: 0;
  box-sizing: border-box;
}

.search-toolbar__input-placeholder {
  color: var(--color-text-placeholder);
}

.search-toolbar__filter-picker-outer {
  flex: none;
}

.search-toolbar__filter-btn-wrap {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-toolbar__filter-dot {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-round);
  background-color: var(--color-danger);
  box-sizing: border-box;
  pointer-events: none;
}
