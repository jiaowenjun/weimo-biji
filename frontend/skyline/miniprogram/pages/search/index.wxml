<view
  class="search-shell ds-page-inline-shell"
  style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight : 0}}px;"
>
  <view class="page-scroll-shell">
    <scroll-view
      id="search-results-scroll"
      class="search-results-scroll"
      scroll-y
      type="custom"
      show-scrollbar="{{false}}"
      bindscrolltolower="handleScrollToLower"
      bindscroll="handlePageScroll"
      lower-threshold="200"
      cache-extent="500"
    >
      <view class="page-nav-spacer" style="height: {{navBarOverlayHeight}}px;"></view>
      <view class="memo-list-top-gap"></view>

      <view class="filter-bar memo-list-filter--scroll-root {{dateLabel || facetLabel ? '' : 'filter-bar--collapsed'}}">
        <filter-summary
          wx:if="{{dateLabel}}"
          value="{{dateLabel}}"
          bind:clear="handleClearDate"
        />
        <filter-summary
          wx:if="{{facetLabel}}"
          value="{{facetLabel}}"
          bind:clear="handleClearFacet"
        />
      </view>

      <view wx:if="{{!memoListInitialized}}" class="memo-list memo-list--scroll-content">
        <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="memo-skeleton ds-surface-card ds-skeleton-card" list-item>
          <view class="memo-skeleton__header" />
          <view class="memo-skeleton__body">
            <view class="memo-skeleton__line" />
            <view class="memo-skeleton__line memo-skeleton__line--mid" />
            <view class="memo-skeleton__line memo-skeleton__line--short" />
          </view>
          <view class="memo-skeleton__tags">
            <view class="memo-skeleton__tag" />
            <view class="memo-skeleton__tag memo-skeleton__tag--narrow" />
          </view>
        </view>
      </view>

      <error-state
        wx:elif="{{memoListInitialLoadFailed && memoCards.length === 0}}"
        message="{{hasActiveQuery ? '搜索结果加载失败' : '笔记列表加载失败'}}"
        retry-text="重新加载"
        bind:retry="handleRetryLoad"
      />

      <empty-state
        wx:elif="{{memoCards.length === 0}}"
        title="{{emptyTitle}}"
        description="{{emptyDescription}}"
        action-text=""
      />

      <block wx:else>
        <list-builder
          class="memo-list memo-list-builder--scroll-root search-results__content"
          type="dynamic"
          list="{{memoRenderCards}}"
          child-count="{{memoRenderCards.length}}"
          initial-child-count="12"
        >
          <view slot:item slot:index class="memo-list__item memo-list__item--scroll-root">
            <view wx:if="{{item.tombstone}}" class="memo-list__item-tombstone"></view>
            <memo-card
              wx:else
              memo-id="{{item.id}}"
              created-at-text="{{item.createdAtText}}"
              content="{{item.content}}"
              content-nodes="{{item.contentNodes}}"
              render-rich-text="{{item.renderRichText}}"
              tags="{{item.tags}}"
              reference-preview="{{item.referencePreview}}"
              referenced-by-previews="{{item.referencedByPreviews}}"
              exiting="{{item.exiting}}"
              entering="{{enteringCardMap[item.id]}}"
              external-menu="{{true}}"
              external-menu-active="{{singletonMenuActive && singletonMenuMemoId === item.id}}"
              external-popover-mode="{{singletonMenuMode}}"
              selected-tag="{{draft.selectedTag}}"
              viewer-role="{{viewerRole}}"
              owner-username="{{friend ? friend.username : ''}}"
              bind:tap="handleMemoCardTap"
              bind:edit="handleMemoEdit"
              bind:quote="handleMemoQuote"
              bind:referencetap="handleMemoReferenceTap"
              bind:delete="handleMemoDelete"
              bind:modifytag="handleMemoModifyTag"
              bind:tagadd="handleMemoTagAdd"
              bind:tagremove="handleMemoTagRemove"
              bind:share="handleMemoShare"
              bind:copy="handleMemoCopy"
              bind:tagtap="handleMemoTagTap"
              bind:menuchange="handleCardMenuChange"
              bind:menuopen="onCardMenuOpen"
            />
          </view>
        </list-builder>

        <view class="memo-list__footer ds-list-footer">
          <text wx:if="{{memoListLoadingMore}}" class="memo-list__footer-text">正在加载更多笔记...</text>
          <weimo-button
            wx:elif="{{memoListLoadMoreFailed}}"
            variant="outline"
            tone="brand"
            size="sm"
            shape="pill"
            bind:tap="handleLoadMore"
          >
            重试加载更多
          </weimo-button>
          <text wx:elif="{{!memoHasMore && memoCards.length > 0}}" class="memo-list__footer-text">已加载全部笔记</text>
        </view>
      </block>

      <view class="page-shell__safe-bottom"></view>
    </scroll-view>

    <weimo-popover-menu
      visible="{{singletonMenuActive}}"
      trigger-rect="{{singletonMenuAnchorRect}}"
      header="{{singletonMenuHeader}}"
      items="{{singletonMenuItems}}"
      estimated-height="{{singletonMenuEstimatedHeight}}"
      placement-priority="{{singletonMenuPlacementPriority}}"
      horizontal-align="{{singletonMenuHorizontalAlign}}"
      scale-anchor="{{singletonMenuScaleAnchor}}"
      bind:select="onSingletonMenuSelect"
      bind:close="closeSingletonMenu"
    />

    <page-nav-chrome
      ext-class="weui-navigation-bar--title-base"
      title="{{navBarTitle}}"
      title-leading-icon="search"
      title-menu-items="{{titleMenuItems}}"
      transparent="{{navChromeTransparent}}"
      status-mask-height="{{navBarStatusMaskHeight}}"
      bind:titlemenuselect="handleTitleMenuSelect"
    />
  </view>

  <view
    class="footer-panel {{keyboardHeight > 0 ? '' : 'footer-panel--rest'}}"
    style="bottom: {{keyboardHeight > 0 ? keyboardHeight : 0}}px;"
  >
    <view class="search-toolbar">
      <view class="search-toolbar__input-shell ds-field-shell ds-surface-floating ds-surface-frosted">
        <text class="iconfont iconfont--search search-toolbar__input-icon"></text>
        <input
          class="search-toolbar__input"
          value="{{draft.keyword}}"
          placeholder="搜索笔记"
          placeholder-class="search-toolbar__input-placeholder"
          focus="{{keywordFocus}}"
          hold-keyboard="{{true}}"
          adjust-position="{{false}}"
          cursor-spacing="16"
          confirm-type="search"
          bindinput="handleKeywordInput"
          bindconfirm="handleKeywordConfirm"
          bindkeyboardheightchange="handleKeyboardHeightChange"
        />
        <weimo-icon-button
          wx:if="{{draft.keyword}}"
          icon="close-circle-filled"
          variant="plain"
          tone="neutral"
          size="sm"
          iconSize="var(--input-inner-icon-size)"
          hoverable="{{false}}"
          customStyle="margin-left: 8rpx;"
          ariaLabel="清除关键词"
          bind:tap="handleKeywordClear"
        />
      </view>
      <view class="search-toolbar__filter-btn-wrap" style="margin-left: var(--spacing-sm);">
        <weimo-icon-button
          icon="hashtag"
          variant="glass"
          tone="brand"
          size="lg"
          ariaLabel="选择标签"
          bind:tap="handleTagPick"
        />
        <view
          wx:if="{{showTagFilterBadge}}"
          class="search-toolbar__filter-dot"
          aria-hidden="true"
        />
      </view>
      <view class="search-toolbar__filter-picker-outer" style="margin-left: var(--spacing-sm);">
        <picker
          mode="date"
          fields="day"
          value="{{draft.dateMode === 'day' && draft.dateValue ? draft.dateValue : todayValue}}"
          bindchange="handleDayPick"
        >
          <view class="search-toolbar__filter-btn-wrap">
            <weimo-icon-button
              icon="calendar"
              variant="glass"
              tone="brand"
              size="lg"
              captureTap="{{false}}"
              ariaLabel="指定日期"
            />
            <view
              wx:if="{{showDateFilterBadge}}"
              class="search-toolbar__filter-dot"
              aria-hidden="true"
            />
          </view>
        </picker>
      </view>
    </view>
  </view>
</view>
