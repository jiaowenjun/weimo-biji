@import '../../styles/memo-markdown.wxss';
@import '../../styles/memo-list.wxss';

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-gesture-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.page-scroll-shell {
  position: relative;
  flex: 1;
  min-height: 0;
}

.page-scroll {
  flex: 1;
  height: 100%;
  overflow: hidden;
}

.page-nav-spacer {
  flex: none;
}

.memo-list-filter--scroll-root {
  margin-left: var(--page-shell-inline-padding);
  margin-right: var(--page-shell-inline-padding);
}

.memo-list--scroll-content {
  margin: 0;
  padding: 0 var(--memo-layout-gutter);
}

.memo-list-builder--scroll-root {
  margin: 0;
  padding: 0;
}

.memo-list__item--scroll-root {
  padding: 0 var(--memo-layout-gutter);
  box-sizing: border-box;
}

.page-shell__safe-bottom {
  flex: none;
  height: calc(env(safe-area-inset-bottom) + var(--page-shell-safe-bottom-space));
}

.nav-search-btn {
  flex: none;
  width: var(--nav-search-btn-size);
  height: var(--nav-search-btn-size);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: calc(8px - 2.5rpx);
  border-radius: var(--radius-round);
  /* 与 brand-light 同色相透明底，避免 Skyline 下 transparent 过渡灰帧 */
  background-color: var(--color-brand-ghost-transparent);
  transition: opacity 0.2s ease, background-color 0.2s ease;
}

.nav-search-btn--hover {
  opacity: 0.72;
}

.nav-search-btn__icon {
  font-size: var(--nav-bar-icon-size);
  color: var(--color-text-secondary);
  line-height: 1;
}

/* FAB */
.fab {
  position: fixed;
  left: 50%;
  margin-left: calc(-1 * var(--floating-action-size) / 2);
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  width: var(--floating-action-size);
  height: var(--floating-action-size);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  /* Skyline 真机下 fab 的 transform 过渡使用 var() 会丢动画，保持字面量。 */
  transition:
    transform 0.4s cubic-bezier(0.33, 1, 0.68, 1),
    opacity 0.28s ease;
}

.fab--hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.fab--compact {
  transform: scale(0.76) translateY(56rpx);
  opacity: 0.9;
}

.fab--compact.fab--hover {
  opacity: 0.8;
  transform: scale(0.722) translateY(56rpx);
}

.fab__icon {
  font-size: 40rpx;
  color: var(--color-brand);
  line-height: 1;
}
