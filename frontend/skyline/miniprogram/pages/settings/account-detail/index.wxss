page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.account-card {
  display: flex;
  flex-direction: column;
  padding: var(--spacing-sm) var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.account-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
}

.account-row--active {
  opacity: 0.72;
}

.account-row--border {
  border-top: 1rpx solid var(--color-border-light);
}

.account-row__content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.account-row__label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.account-row__value {
  margin-top: 4rpx;
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.45;
}

.account-row__value--readonly {
  color: var(--color-text-secondary);
}

.account-row__action {
  flex-shrink: 0;
  padding: var(--spacing-xs);
}

.account-row__chevron {
  font-size: var(--font-size-base);
  color: var(--color-text-placeholder);
}
