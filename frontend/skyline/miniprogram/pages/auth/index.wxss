page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  line-height: 1.5;
}

.page-scroll {
  flex: 1;
  overflow-y: hidden;
}

/* --- Auth hero --- */

.auth-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.auth-hero {
  padding: 80rpx var(--spacing-xs) var(--spacing-xl);
}

.auth-brand {
  display: block;
  margin-bottom: 12rpx;
  color: var(--color-brand);
  font-size: var(--font-size-sm);
  letter-spacing: 0.18em;
}

.auth-title-block {
  display: flex;
  flex-direction: column;
}

.auth-title {
  display: block;
  color: var(--color-text-primary);
  font-size: var(--font-size-xxl);
  font-weight: 600;
  line-height: 1.2;
}

.auth-subtitle {
  display: block;
  margin-top: var(--spacing-sm);
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  line-height: 1.7;
}

.auth-actions {
  padding: 0 28rpx;
}

/* --- Profile panel (bottom sheet via view + CSS transition) --- */

.profile-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-mask);
  z-index: 100;
}

.profile-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-lg) var(--spacing-lg) calc(env(safe-area-inset-bottom) + var(--spacing-lg));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease, bottom 0.25s ease;
}

.profile-panel--visible {
  transform: translateY(0);
}

.profile-header {
  margin-bottom: var(--spacing-lg);
}

.profile-title {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
}

.profile-desc {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.profile-form {
  margin-bottom: var(--spacing-lg);
}

.profile-nickname-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-bg-elevated);
  border-radius: var(--radius-md);
}

.profile-nickname-label {
  flex: none;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-right: var(--spacing-md);
}

.profile-nickname-input {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

/* --- Preview state --- */

.profile-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.profile-preview-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* --- Actions --- */

.profile-actions {
  padding: 0;
}
