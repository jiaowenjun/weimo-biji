<navigation-bar title="通知" back="{{true}}" />

<scroll-view class="notifications-scroll" scroll-y type="list" enhanced="{{true}}" show-scrollbar="{{false}}">
  <page-shell padding="{{true}}">
    <view wx:if="{{loading}}" class="notifications-status">
      <text class="notifications-status__text">加载通知中...</text>
    </view>
    <view wx:elif="{{loadFailed}}" class="notifications-status">
      <text class="notifications-status__text">通知加载失败</text>
      <view class="notifications-status__retry">
        <weimo-button variant="outline" tone="brand" size="xs" shape="pill" bind:tap="handleRetry">
          重试
        </weimo-button>
      </view>
    </view>
    <view wx:elif="{{rows.length === 0}}" class="notifications-status">
      <text class="notifications-status__text">暂无通知</text>
    </view>
    <view wx:else class="notifications-list">
      <view wx:for="{{rows}}" wx:key="id" class="notification-row ds-surface-card">
        <image
          wx:if="{{item.resolvedAvatarUrl}}"
          class="notification-row__avatar"
          src="{{item.resolvedAvatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="notification-row__avatar notification-row__avatar--fallback">
          <text class="iconfont iconfont--user-1 notification-row__avatar-icon"></text>
        </view>
        <view class="notification-row__body">
          <text class="notification-row__title" overflow="ellipsis" max-lines="1">{{item.title}}</text>
          <text class="notification-row__description">{{item.description}}</text>
        </view>
        <weimo-button
          wx:if="{{item.actionLabel}}"
          variant="{{item.actionDisabled ? 'outline' : 'solid'}}"
          tone="brand"
          size="xs"
          shape="pill"
          disabled="{{item.actionDisabled || acceptingRequestId === item.requestId}}"
          loading="{{acceptingRequestId === item.requestId}}"
          data-request-id="{{item.requestId}}"
          bind:tap="handleAcceptTap"
        >
          {{item.actionLabel}}
        </weimo-button>
      </view>
    </view>
  </page-shell>
</scroll-view>
