<navigation-bar title="添加朋友" modal="{{true}}" compact="{{true}}" />

<view
  class="friend-search-shell ds-page-inline-shell"
  style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight : 0}}px;"
>
  <scroll-view
    class="friend-search-results-scroll"
    scroll-y
    type="list"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="friend-search-results-scroll__content">
      <view wx:if="{{loading}}" class="friend-search-status">
        <text class="friend-search-status__text">搜索中...</text>
      </view>
      <view wx:elif="{{loadFailed}}" class="friend-search-status">
        <text class="friend-search-status__text">搜索失败</text>
        <view class="friend-search-status__retry">
          <weimo-button variant="outline" tone="brand" size="xs" shape="pill" bind:tap="handleRetry">
            重试
          </weimo-button>
        </view>
      </view>
      <view wx:elif="{{!hasQuery}}" class="friend-search-status">
        <text class="friend-search-status__text">输入昵称搜索用户</text>
      </view>
      <view wx:elif="{{rows.length === 0}}" class="friend-search-status">
        <text class="friend-search-status__text">没有找到用户</text>
      </view>
      <view wx:else class="friend-search-results">
        <view
          wx:for="{{rows}}"
          wx:key="username"
          class="friend-search-result"
        >
          <image
            wx:if="{{item.resolvedAvatarUrl}}"
            class="friend-search-result__avatar"
            src="{{item.resolvedAvatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="friend-search-result__avatar friend-search-result__avatar--fallback">
            <text class="iconfont iconfont--user-1 friend-search-result__avatar-icon"></text>
          </view>
          <view class="friend-search-result__body">
            <text overflow="ellipsis" max-lines="1" class="friend-search-result__nickname">{{item.user.nickname}}</text>
          </view>
          <weimo-button
            variant="{{item.button.disabled ? 'outline' : 'solid'}}"
            tone="brand"
            size="xs"
            shape="pill"
            disabled="{{item.button.disabled || followingUsername === item.user.username}}"
            loading="{{followingUsername === item.user.username}}"
            data-username="{{item.user.username}}"
            bind:tap="handleFollowTap"
          >
            {{item.button.label}}
          </weimo-button>
        </view>
      </view>
    </view>
  </scroll-view>

  <view
    class="friend-search-toolbar {{keyboardHeight > 0 ? '' : 'friend-search-toolbar--rest'}}"
    style="bottom: {{keyboardHeight > 0 ? keyboardHeight : 0}}px;"
  >
    <view class="friend-search-toolbar__input-shell ds-field-shell ds-surface-floating ds-surface-frosted">
      <text class="iconfont iconfont--search friend-search-toolbar__input-icon"></text>
      <input
        class="friend-search-toolbar__input"
        value="{{draft}}"
        placeholder="搜索昵称"
        placeholder-class="friend-search-toolbar__input-placeholder"
        focus="{{inputFocus}}"
        hold-keyboard="{{true}}"
        cursor-spacing="16"
        adjust-position="{{false}}"
        confirm-type="search"
        bindinput="handleDraftInput"
        bindconfirm="handleConfirm"
        bindkeyboardheightchange="handleKeyboardHeightChange"
      />
      <weimo-icon-button
        wx:if="{{draft}}"
        icon="close-circle-filled"
        variant="plain"
        tone="neutral"
        size="sm"
        iconSize="var(--input-inner-icon-size)"
        hoverable="{{false}}"
        customStyle="margin-left: 8rpx;"
        ariaLabel="清除输入"
        bind:tap="handleClearDraft"
      />
    </view>
  </view>
</view>
