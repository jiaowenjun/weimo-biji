.weimo-toggle-button {
  flex: none;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 80rpx;
  min-width: 80rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
  background-color: var(--color-toggle-rest-surface);
  transition:
    background-color 180ms ease,
    opacity 180ms ease;
}

.weimo-toggle-button--selected {
  background-color: var(--color-toggle-selected-surface);
}

.weimo-toggle-button--disabled {
  opacity: 0.3;
}

.weimo-toggle-button__icon {
  color: var(--color-text-primary);
}

.weimo-toggle-button--selected .weimo-toggle-button__icon {
  color: var(--color-brand);
}

.weimo-toggle-button__icon {
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
}

.weimo-toggle-button__label {
  font-size: 18rpx;
  font-weight: normal;
  color: var(--color-text-placeholder);
  white-space: nowrap;
  line-height: 24rpx;
}

.weimo-toggle-button--selected .weimo-toggle-button__label {
  color: var(--color-heat-3);
}
