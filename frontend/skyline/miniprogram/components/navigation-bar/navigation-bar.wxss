.weui-navigation-bar {
  --weui-FG-0: var(--color-text-primary, rgba(0,0,0,.9));
  --weui-BG-0: var(--color-bg-card, #ffffff);
  --height: 44px;
  --left: 16px;
}
.weui-navigation-bar .android {
  --height: 48px;
}

.weui-navigation-bar {
  overflow: hidden;
  color: var(--weui-FG-0);
  flex: none;
}

.weui-navigation-bar__inner {
  position: relative;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

/** 模态页：标题需在屏幕水平中线居中；左右操作区宽度常不对称（如左返回 vs 右双图标），
 *   若仅用 flex:1 居中，几何中心会落在「左右缘之间」而非视窗中线。
 *   做法：左右各占 flex:1 把图标分别贴齐两侧留白；标题 absolute + translateX(-50%) 对齐中线；
 *   左右容器 pointer-events:none，对左侧 .weui-navigation-bar__buttons / .weui-navigation-bar__left-slot
 *   与右侧 .weui-navigation-bar__right-slot 设为 auto，避免宽 flex 挡标题触控。 */
.weui-navigation-bar__inner--modal {
  justify-content: space-between;
  position: relative;
}

.weui-navigation-bar__inner--modal .weui-navigation-bar__left {
  flex: 1;
  justify-content: flex-start;
  min-width: 0;
}

.weui-navigation-bar__inner--modal .weui-navigation-bar__right {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  min-width: 0;
}

.weui-navigation-bar__inner--modal .weui-navigation-bar__left,
.weui-navigation-bar__inner--modal .weui-navigation-bar__right {
  pointer-events: none;
  position: relative;
  z-index: 2;
}

.weui-navigation-bar__inner--modal .weui-navigation-bar__left .weui-navigation-bar__buttons,
.weui-navigation-bar__inner--modal .weui-navigation-bar__left .weui-navigation-bar__left-slot {
  pointer-events: auto;
}

.weui-navigation-bar__inner--modal .weui-navigation-bar__right-slot {
  pointer-events: auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.weui-navigation-bar__inner--modal .weui-navigation-bar__center {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  transform: translateX(-50%);
  flex: none;
  width: auto;
  max-width: 52%;
  z-index: 1;
}

.weui-navigation-bar__left {
  position: relative;
  padding-left: var(--left);
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
  box-sizing: border-box;
}

.weui-navigation-bar__buttons,
.weui-navigation-bar__left-slot {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
}

.weui-navigation-bar__left-slot {
  min-width: 0;
}

.weui-navigation-bar__btn_goback_wrapper {
  padding: 11px 18px 11px 16px;
  margin: -11px -18px -11px -16px;
}

.weui-navigation-bar__btn_goback_wrapper.weui-active {
  opacity: 0.5;
}

.weui-navigation-bar__btn_goback {
  font-size: var(--nav-bar-icon-size);
  line-height: 1;
  color: var(--color-text-secondary);
}

.weui-navigation-bar__btn_home_wrapper {
  padding: 11px 18px 11px 16px;
  margin: -11px -18px -11px -16px;
}

.weui-navigation-bar__btn_home_wrapper.weui-active {
  opacity: 0.5;
}

.weui-navigation-bar__btn_home {
  font-size: var(--nav-bar-icon-size);
  line-height: 1;
  color: var(--color-text-secondary);
}

.weui-navigation-bar__btn_menu_wrapper {
  padding: 11px 18px 11px 16px;
  margin: -11px -18px -11px -16px;
}

.weui-navigation-bar__btn_menu_wrapper.weui-active {
  opacity: 0.5;
}

.weui-navigation-bar__btn_menu {
  font-size: var(--nav-bar-icon-size);
  line-height: 1;
  color: var(--color-text-secondary);
}

.weui-navigation-bar__center {
  min-width: 0;
  font-size: var(--font-size-md);
  text-align: center;
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  flex: 1;
  height: 100%;
}

.weui-navigation-bar__title-leading-icon {
  flex-shrink: 0;
  margin-right: 4rpx;
  font-size: var(--font-size-base);
  line-height: 1;
  color: var(--color-text-placeholder);
}

.weui-navigation-bar__title-text {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text-secondary);
}

.weui-navigation-bar__title-trigger {
  min-width: 0;
  max-width: 100%;
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-round);
}

.weui-navigation-bar__title-trigger--clickable {
  padding: 8rpx 18rpx;
  margin: -8rpx -18rpx;
}

.weui-navigation-bar__title-trigger--hover {
  opacity: 0.7;
}

.weui-navigation-bar__title-chevron {
  margin-left: 4rpx;
  font-size: var(--font-size-base);
  line-height: 1;
  color: var(--color-text-placeholder);
}

.weui-navigation-bar__loading {
  margin-right: 4px;
  align-items: center;
}

.weui-loading {
  font-size: 16px;
  width: 16px;
  height: 16px;
  display: block;
  background: transparent url("data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg width='80px' height='80px' viewBox='0 0 80 80' version='1.1' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink'%3E%3Ctitle%3Eloading%3C/title%3E%3Cdefs%3E%3ClinearGradient x1='94.0869141%25' y1='0%25' x2='94.0869141%25' y2='90.559082%25' id='linearGradient-1'%3E%3Cstop stop-color='%23606060' stop-opacity='0' offset='0%25'%3E%3C/stop%3E%3Cstop stop-color='%23606060' stop-opacity='0.3' offset='100%25'%3E%3C/stop%3E%3C/linearGradient%3E%3ClinearGradient x1='100%25' y1='8.67370605%25' x2='100%25' y2='90.6286621%25' id='linearGradient-2'%3E%3Cstop stop-color='%23606060' offset='0%25'%3E%3C/stop%3E%3Cstop stop-color='%23606060' stop-opacity='0.3' offset='100%25'%3E%3C/stop%3E%3C/linearGradient%3E%3C/defs%3E%3Cg stroke='none' stroke-width='1' fill='none' fill-rule='evenodd' opacity='0.9'%3E%3Cg%3E%3Cpath d='M40,0 C62.09139,0 80,17.90861 80,40 C80,62.09139 62.09139,80 40,80 L40,73 C58.2253967,73 73,58.2253967 73,40 C73,21.7746033 58.2253967,7 40,7 L40,0 Z' fill='url(%23linearGradient-1)'%3E%3C/path%3E%3Cpath d='M40,0 L40,7 C21.7746033,7 7,21.7746033 7,40 C7,58.2253967 21.7746033,73 40,73 L40,80 C17.90861,80 0,62.09139 0,40 C0,17.90861 17.90861,0 40,0 Z' fill='url(%23linearGradient-2)'%3E%3C/path%3E%3Ccircle id='Oval' fill='%23606060' cx='40.5' cy='3.5' r='3.5'%3E%3C/circle%3E%3C/g%3E%3C/g%3E%3C/svg%3E%0A") no-repeat;
  background-size: 100%;
  margin-left: 0;
  animation: loading linear infinite 1s;
}

@keyframes loading {
  from {
    transform: rotate(0);
  }
  to {
    transform: rotate(360deg);
  }
}

.weui-navigation-bar--compact .weui-navigation-bar__center {
  font-size: var(--font-size-base);
}

/* 与 compact 标题同字号，但不改变栏高/安全区（全屏列表页与模态编辑页标题对齐） */
.weui-navigation-bar--title-base .weui-navigation-bar__center {
  font-size: var(--font-size-base);
}
