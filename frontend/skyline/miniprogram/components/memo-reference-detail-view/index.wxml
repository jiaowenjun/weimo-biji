<block wx:if="{{mode === 'references'}}">
  <memo-card
    wx:for="{{referenceCards}}"
    wx:key="id"
    memo-id="{{item.id}}"
    created-at-text="{{item.createdAtText}}"
    content="{{item.content}}"
    content-nodes="{{item.contentNodes}}"
    render-rich-text="{{item.renderRichText}}"
    tags="{{item.tags}}"
    reference-preview="{{item.referencePreview}}"
    referenced-by-previews="{{item.referencedByPreviews}}"
    viewer-role="self"
    menu-gesture-gate="{{true}}"
    bind:tap="handleCardTap"
    bind:edit="handleCardEdit"
    bind:quote="handleCardQuote"
    bind:delete="handleCardDelete"
    bind:modifytag="handleCardModifyTag"
    bind:tagadd="handleCardTagAdd"
    bind:tagremove="handleCardTagRemove"
    bind:referencetap="handleMemoReferenceTap"
    bind:share="handleCardShare"
    bind:copy="handleCardCopy"
    bind:menuchange="handleCardMenuChange"
    bind:gesturegatechange="handleCardGestureGateChange"
  />
</block>

<block wx:elif="{{mode === 'detail'}}">
  <memo-card
    wx:if="{{rootCard !== null}}"
    memo-id="{{rootCard.id}}"
    created-at-text="{{rootCard.createdAtText}}"
    content="{{rootCard.content}}"
    content-nodes="{{rootCard.contentNodes}}"
    render-rich-text="{{rootCard.renderRichText}}"
    tags="{{rootCard.tags}}"
    reference-preview="{{rootCard.referencePreview}}"
    referenced-by-previews="{{rootCard.referencedByPreviews}}"
    show-reference-bar="{{false}}"
    viewer-role="{{rootViewerRole}}"
    menu-gesture-gate="{{true}}"
    bind:tap="handleCardTap"
    bind:edit="handleCardEdit"
    bind:quote="handleCardQuote"
    bind:delete="handleCardDelete"
    bind:modifytag="handleCardModifyTag"
    bind:tagadd="handleCardTagAdd"
    bind:tagremove="handleCardTagRemove"
    bind:referencetap="handleMemoReferenceTap"
    bind:share="handleCardShare"
    bind:copy="handleCardCopy"
    bind:menuchange="handleCardMenuChange"
    bind:gesturegatechange="handleCardGestureGateChange"
  />

  <horizontal-drag-gesture-handler
    worklet:ongesture="handleRelationPanelDrag"
    worklet:should-accept-gesture="shouldAcceptRelationPanelDrag"
    worklet:should-response-on-move="shouldRespondRelationPanelDrag"
  >
  <view wx:if="{{relationPanelsTrackMounted}}" class="memo-reference-relation-gesture-stack">
    <view class="memo-reference-relation-panels" style="{{relationPanelsHeightStyle}}">
    <view class="memo-reference-relation-panels__track">
      <view
        class="memo-reference-relation-panels__panel{{selectedRelationTab === 'reference' ? ' memo-reference-relation-panels__panel--active' : ''}}"
        data-relation-panel="reference"
      >
        <view wx:if="{{referenceCards.length}}" class="memo-reference-section">
          <view class="memo-reference-section__title">
            <text class="memo-reference-section__title-text">- 引用以下 {{referenceCards.length}} 条笔记 -</text>
          </view>
          <memo-card
            wx:for="{{referenceCards}}"
            wx:key="id"
            memo-id="{{item.id}}"
            created-at-text="{{item.createdAtText}}"
            content="{{item.content}}"
            content-nodes="{{item.contentNodes}}"
            render-rich-text="{{item.renderRichText}}"
            tags="{{item.tags}}"
            reference-preview="{{item.referencePreview}}"
            referenced-by-previews="{{item.referencedByPreviews}}"
            viewer-role="self"
            menu-gesture-gate="{{true}}"
            bind:tap="handleCardTap"
            bind:edit="handleCardEdit"
            bind:quote="handleCardQuote"
            bind:delete="handleCardDelete"
            bind:modifytag="handleCardModifyTag"
            bind:tagadd="handleCardTagAdd"
            bind:tagremove="handleCardTagRemove"
            bind:referencetap="handleMemoReferenceTap"
            bind:share="handleCardShare"
            bind:copy="handleCardCopy"
            bind:menuchange="handleCardMenuChange"
            bind:gesturegatechange="handleCardGestureGateChange"
          />
        </view>
      </view>

      <view
        class="memo-reference-relation-panels__panel{{selectedRelationTab === 'referencedBy' ? ' memo-reference-relation-panels__panel--active' : ''}}"
        data-relation-panel="referencedBy"
      >
        <view wx:if="{{referencedByCards.length}}" class="memo-reference-section">
          <view class="memo-reference-section__title">
            <text class="memo-reference-section__title-text">- 被以下 {{referencedByCards.length}} 条笔记引用 -</text>
          </view>
          <memo-card
            wx:for="{{referencedByCards}}"
            wx:key="id"
            memo-id="{{item.id}}"
            created-at-text="{{item.createdAtText}}"
            content="{{item.content}}"
            content-nodes="{{item.contentNodes}}"
            render-rich-text="{{item.renderRichText}}"
            tags="{{item.tags}}"
            reference-preview="{{item.referencePreview}}"
            referenced-by-previews="{{item.referencedByPreviews}}"
            viewer-role="self"
            menu-gesture-gate="{{true}}"
            bind:tap="handleCardTap"
            bind:edit="handleCardEdit"
            bind:quote="handleCardQuote"
            bind:delete="handleCardDelete"
            bind:modifytag="handleCardModifyTag"
            bind:tagadd="handleCardTagAdd"
            bind:tagremove="handleCardTagRemove"
            bind:referencetap="handleMemoReferenceTap"
            bind:share="handleCardShare"
            bind:copy="handleCardCopy"
            bind:menuchange="handleCardMenuChange"
            bind:gesturegatechange="handleCardGestureGateChange"
          />
        </view>
      </view>
    </view>
    </view>
    <view
      wx:if="{{relationGestureFillStyle}}"
      class="memo-reference-relation-gesture-hitfill"
      style="{{relationGestureFillStyle}}"
    ></view>
  </view>

  <view wx:else class="memo-reference-relation-flat">
    <view wx:if="{{referenceCards.length}}" class="memo-reference-section">
      <view class="memo-reference-section__title">
        <text class="memo-reference-section__title-text">- 引用以下 {{referenceCards.length}} 条笔记 -</text>
      </view>
      <memo-card
        wx:for="{{referenceCards}}"
        wx:key="id"
        memo-id="{{item.id}}"
        created-at-text="{{item.createdAtText}}"
        content="{{item.content}}"
        content-nodes="{{item.contentNodes}}"
        render-rich-text="{{item.renderRichText}}"
        tags="{{item.tags}}"
        reference-preview="{{item.referencePreview}}"
        referenced-by-previews="{{item.referencedByPreviews}}"
        viewer-role="self"
        menu-gesture-gate="{{true}}"
        bind:tap="handleCardTap"
        bind:edit="handleCardEdit"
        bind:quote="handleCardQuote"
        bind:delete="handleCardDelete"
        bind:modifytag="handleCardModifyTag"
        bind:tagadd="handleCardTagAdd"
        bind:tagremove="handleCardTagRemove"
        bind:referencetap="handleMemoReferenceTap"
        bind:share="handleCardShare"
        bind:copy="handleCardCopy"
        bind:menuchange="handleCardMenuChange"
        bind:gesturegatechange="handleCardGestureGateChange"
      />
    </view>

    <view wx:if="{{referencedByCards.length}}" class="memo-reference-section">
      <view class="memo-reference-section__title">
        <text class="memo-reference-section__title-text">- 被以下 {{referencedByCards.length}} 条笔记引用 -</text>
      </view>
      <memo-card
        wx:for="{{referencedByCards}}"
        wx:key="id"
        memo-id="{{item.id}}"
        created-at-text="{{item.createdAtText}}"
        content="{{item.content}}"
        content-nodes="{{item.contentNodes}}"
        render-rich-text="{{item.renderRichText}}"
        tags="{{item.tags}}"
        reference-preview="{{item.referencePreview}}"
        referenced-by-previews="{{item.referencedByPreviews}}"
        viewer-role="self"
        menu-gesture-gate="{{true}}"
        bind:tap="handleCardTap"
        bind:edit="handleCardEdit"
        bind:quote="handleCardQuote"
        bind:delete="handleCardDelete"
        bind:modifytag="handleCardModifyTag"
        bind:tagadd="handleCardTagAdd"
        bind:tagremove="handleCardTagRemove"
        bind:referencetap="handleMemoReferenceTap"
        bind:share="handleCardShare"
        bind:copy="handleCardCopy"
        bind:menuchange="handleCardMenuChange"
        bind:gesturegatechange="handleCardGestureGateChange"
      />
    </view>
  </view>
  </horizontal-drag-gesture-handler>
</block>
