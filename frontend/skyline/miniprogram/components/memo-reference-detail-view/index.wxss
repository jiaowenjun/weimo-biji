@import '../../styles/memo-markdown.wxss';

.memo-reference-section {
  margin-top: var(--spacing-md);
}

.memo-reference-section__title {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.memo-reference-section__title-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  line-height: 1.4;
}

.memo-reference-relation-flat {
  display: flex;
  flex-direction: column;
}

/* gesture-hitfill start: 透明热区，扩大 tab 横向滑动手势响应范围 */
.memo-reference-relation-gesture-stack {
  display: flex;
  flex-direction: column;
}

.memo-reference-relation-gesture-hitfill {
  width: 100%;
  flex: none;
}
/* gesture-hitfill end */

/* clip-fix start: 将 overflow:hidden 裁切边界扩至屏幕边缘 */
.memo-reference-relation-panels {
  width: calc(100% + 2 * var(--memo-layout-gutter));
  margin-left: calc(-1 * var(--memo-layout-gutter));
  margin-right: calc(-1 * var(--memo-layout-gutter));
  overflow: hidden;
  transition: height 260ms cubic-bezier(0.4, 0, 0.2, 1);
}
/* clip-fix end */

.memo-reference-relation-panels__track {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--memo-reference-relation-panel-gap);
}

.memo-reference-relation-panels__track--animated {
  transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
}

.memo-reference-relation-panels__panel {
  flex: 0 0 100%;
  width: 100%;
  box-sizing: border-box;
}
